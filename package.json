{
  "name": "@xaamin/guardian",
  "version": "0.2.3",
  "description": "Authorization library with access control lists (ACL), role-based permissions (RBAC), and resource-aware policy gates.",
  "keywords": [
    "acl",
    "authorization",
    "permissions",
    "guardian",
    "gate",
    "policy",
    "access-control",
    "rbac",
    "role-based-access-control",
    "roles",
    "permission",
    "access-control-list",
    "policy-based-access-control",
    "authorization-library",
    "javascript",
    "typescript",
    "nodejs",
    "access",
    "control"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "typings": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "author": "Ben <xaamin@outlook.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/xaamin/guardian-js"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --coverage",
    "test:watch": "vitest --coverage",
    "lint": "eslint src test",
    "release": "release-it",
    "release:patch": "release-it patch",
    "release:minor": "release-it minor",
    "release:major": "release-it major",
    "release:dry": "release-it --dry-run"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@release-it/conventional-changelog": "^12.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^9.0.0",
    "release-it": "^21.0.3",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  }
}
